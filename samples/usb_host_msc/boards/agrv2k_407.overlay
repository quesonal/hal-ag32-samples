/*
 * USB0 as a host controller -- same arrangement as usb_host_enum: the board
 * enables the device role by default, and USB0 is one piece of silicon with
 * one role at a time, so usb0 is disabled and the host node is enabled under
 * the label the host stack looks up.
 */

&usb0 {
	status = "disabled";
};

zephyr_uhc0: &uhc0 {
	status = "okay";
};
