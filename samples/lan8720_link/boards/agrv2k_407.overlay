/*
 * lan8720_link — board overlay for the LAN8720 RMII PHY, on the canonical
 * dev bitstream <your canonical bitstream>
 * (200 MHz SYSCLK / 100 MHz HCLK = the board defaults, MAC pins routed per
 * the table below). The older
 * the 100 MHz development bitstream is the same route at
 * 100 MHz and needs -- -DEXTRA_DTC_OVERLAY_FILE=/tmp/agm100.overlay.
 *
 * Three things land here:
 *
 *   1. Replace the shared pin list with the MAC0 RMII pins (per
 *      the dev bitstream at the 100 MHz development bitstream).
 *      PHY_RSTB (GPIO5_5) and MAC0_PHY_INTB are NOT routed in this
 *      bitstream -- PHY reset is MII_BMCR soft reset only, link is
 *      monitored via BMSR polling (no PHY interrupt needed).
 *
 *   2. Enable the eth0 (MAC0) + mdio0 + phy0 nodes. They live as
 *      status="disabled" in the shared dtsi so the build doesn't
 *      pull in the Ethernet framework for boards that don't have
 *      a PHY.
 *
 *   3. The pinctrl state (eth0_default in dts/riscv/agm/agrv2k.dtsi)
 *      sets AFSEL on the GPIO bank/bit the MAC0 IP expects (per
 *      AltaRiscv.h, MAC0_<X>_AF_GPIO) -- not on the physical pin
 *      number. The bitstream's cross-bar decides which physical
 *      pin each bank/bit lands on; that's what this overlay lists.
 */

&agrv2k_pins {
	mcu-functions =
		/* MAC0 RMII pins -- per the 100 MHz development bitstream
		 * example_board.ve. Pins differ from the SDK lwip.ve route
		 * (which uses PIN_54/57/58/59/62/63/64); this bitstream
		 * moves them to PIN_43..47 + PIN_57..59 and drops the
		 * optional PHY_INTB (PIN_62) + PHY_RSTB (PIN_53/GPIO5_5).
		 *
		 * The bank/bit the AFSEL touches stays the same: each
		 * AgRV2K MAC pin maps to a fixed GPIO bank/bit regardless
		 * of which physical pin the bitstream chooses. */
		"MAC0_RXD0",
		"MAC0_RXD1",
		"MAC0_TXD0",
		"MAC0_TXD1",
		"MAC0_TX_EN",
		"MAC0_CRS",
		"MAC0_TX_CLK",
		"MAC0_MDC",
		"MAC0_MDIO",

		/* The console UART0 is routed by this bitstream as well (the
		 * banner comes out of it), so it belongs in this list: the list
		 * describes what the *bitstream* routes, not just what this
		 * sample uses. tools/check_pinctrl.py compares it against the
		 * netlist. */
		"UART0_UARTRXD",
		"UART0_UARTTXD";
	mcu-pins =
		<47>, <46>,
		<44>, <43>,
		<45>,
		<56>,
		<57>,
		<58>, <59>,

		/* UART0 console: PIN_69 = RX, PIN_68 = TX */
		<69>, <68>;
};

&eth0 {
	status = "okay";
};

&mdio0 {
	status = "okay";
};

&phy0 {
	status = "okay";
};

/* Clock: the dev bitstream is now
 *   <your canonical bitstream>
 * (VE: SYSCLK 200 / BUSCLK 100 / HSECLK 8), which is exactly what the
 * agrv2k_407 board defaults describe (AGM_SYSCLK_HZ 200 MHz,
 * AGM_FLASH_MAX_HZ 100 MHz), so there is nothing to override here.
 *
 * The older 100 MHz bitstream needs the opposite: build with
 *   -- -DEXTRA_DTC_OVERLAY_FILE=/tmp/agm100.overlay
 * (clk0/cpu0 100 MHz, flash ceiling 50 MHz), otherwise the UART baud
 * and the tick rate are both wrong.
 *
 * 2026-09-15: measured on both bitstreams, the iperf2 UDP rate scales
 * with these clocks -- 23.08 Mbit/s (100/50) vs 46.37 (200/100) vs
 * 29.75 (200 SYSCLK but flash held at 50). See
 * the port record (ethernet) §3.28.9.
 */

/* The agm,pins cells (function -> GPIO bank/bit -> dir) are generated:
 * tools/generate_pinctrl_dtsi.py turns this file's mcu-functions list plus
 * the SoC AF table (tools/agm_af_pins.yaml) into that fragment. Do not
 * hand-write them here -- tools/check_pinctrl.py fails if the effective
 * state and the pin list disagree. See the pin-routing notes §12.
 */
#include <agm/pinctrl-devmac.dtsi>
